# Copy this template to .env. Never commit .env or real credentials.
POSTGRES_DB=order_management
POSTGRES_USER=order_app

# Required placeholder: <YOUR_LOCAL_DATABASE_PASSWORD>
# Intentionally empty: set your own value in .env; there is no default password.
# Use single quotes around values containing $ or #.
POSTGRES_PASSWORD=

POSTGRES_PORT=5432
SERVER_PORT=8080

# Optional: disable both /v3/api-docs and Swagger UI when deploying.
API_DOCS_ENABLED=true

# Required for the API (not needed for PostgreSQL-only Compose).
# Run scripts/init-local.ps1 to generate a random secret in your ignored .env.
JWT_SECRET_BASE64=

# Optional one-time operator bootstrap. No default admin account is created.
# Set your own email/password, enable for the first startup, then disable and clear the password.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional overrides when running Java against an existing PostgreSQL instance:
# DB_HOST=localhost
# DB_PORT=5432
